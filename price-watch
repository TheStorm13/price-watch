#!/usr/bin/env sh
set -eu

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
binary="$project_dir/frontend/src-tauri/target/release/price-watch-desktop"

if [ ! -x "$binary" ]; then
    echo "Desktop-приложение не собрано. Выполните: npm --prefix frontend run desktop:build" >&2
    exit 1
fi

exec "$binary"
