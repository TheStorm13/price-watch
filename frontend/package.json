{
  "name": "price-watch-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:desktop": "VITE_DESKTOP_MODE=true vite --host 127.0.0.1 --port 1420 --strictPort",
    "dev:e2e": "VITE_E2E_TEST_MODE=true vite --host 127.0.0.1 --port 5175 --strictPort",
    "build:desktop": "tsc -b && VITE_DESKTOP_MODE=true vite build",
    "desktop": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "tsc -b --pretty false"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.2",
    "@tauri-apps/api": "2.12.2",
    "@tauri-apps/plugin-opener": "2.7.2",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
